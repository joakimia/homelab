{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "host",
    "ingress",
    "prometheus"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "tls",
        "auth",
        "backend"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "clusterIssuer"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clusterIssuer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "required": [
            "enabled",
            "middleware"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "middleware": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "required": [
            "service",
            "port"
          ],
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prometheus": {
      "type": "object",
      "required": [
        "fullnameOverride",
        "prometheus-node-exporter"
      ],
      "properties": {
        "fullnameOverride": {
          "type": "string",
          "minLength": 1
        },
        "prometheus-node-exporter": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaceOverride": {
              "type": "string"
            }
          },
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "namespaceOverride"
            ],
            "properties": {
              "namespaceOverride": {
                "minLength": 1,
                "not": {
                  "const": "hlab-observability"
                },
                "description": "node-exporter needs host namespaces and hostPath: run it in a privileged namespace, not the baseline hlab-observability."
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
