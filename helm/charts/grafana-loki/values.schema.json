{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "loki"
  ],
  "properties": {
    "loki": {
      "type": "object",
      "required": [
        "fullnameOverride",
        "deploymentMode"
      ],
      "properties": {
        "fullnameOverride": {
          "type": "string",
          "minLength": 1
        },
        "deploymentMode": {
          "const": "Monolithic"
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
