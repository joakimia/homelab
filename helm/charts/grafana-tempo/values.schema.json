{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "tempo"
  ],
  "properties": {
    "tempo": {
      "type": "object",
      "required": [
        "fullnameOverride",
        "persistence"
      ],
      "properties": {
        "fullnameOverride": {
          "type": "string",
          "minLength": 1
        },
        "persistence": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": true
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
