{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "name",
    "storageClassName",
    "accessModes",
    "size",
    "keep"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
    },
    "storageClassName": {
      "type": "string",
      "minLength": 1
    },
    "accessModes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "ReadWriteOnce",
          "ReadWriteOncePod",
          "ReadWriteMany",
          "ReadOnlyMany"
        ]
      }
    },
    "size": {
      "type": "string",
      "pattern": "^[0-9]+(Mi|Gi|Ti)$"
    },
    "keep": {
      "type": "boolean"
    }
  }
}
