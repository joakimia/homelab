{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "cert-manager"
  ],
  "properties": {
    "cert-manager": {
      "type": "object",
      "required": [
        "crds"
      ],
      "properties": {
        "crds": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "keep": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
