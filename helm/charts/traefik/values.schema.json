{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "image",
    "namespace",
    "replicaCount",
    "ports",
    "ingress",
    "resources",
    "probes",
    "service",
    "podSecurityContext",
    "securityContext",
    "forwardAuth"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "ports": {
      "type": "object",
      "required": [
        "web",
        "websecure",
        "traefik"
      ],
      "properties": {
        "web": {
          "$ref": "#/definitions/port"
        },
        "websecure": {
          "$ref": "#/definitions/port"
        },
        "traefik": {
          "type": "object",
          "required": [
            "containerPort"
          ],
          "properties": {
            "containerPort": {
              "$ref": "#/definitions/portNumber"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "type",
        "ports"
      ],
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "ports": {
          "type": "object",
          "required": [
            "web",
            "websecure"
          ],
          "properties": {
            "web": {
              "$ref": "#/definitions/portNumber"
            },
            "websecure": {
              "$ref": "#/definitions/portNumber"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "isDefaultClass"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "isDefaultClass": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceMap"
        },
        "limits": {
          "$ref": "#/definitions/resourceMap"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "required": [
        "readiness",
        "liveness",
        "startup"
      ],
      "properties": {
        "readiness": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        },
        "startup": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "forwardAuth": {
      "type": "object",
      "required": [
        "enabled",
        "address"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "address": {
          "type": "string",
          "pattern": "^https?://"
        },
        "authResponseHeaders": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "definitions": {
    "portNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "port": {
      "type": "object",
      "required": [
        "containerPort"
      ],
      "properties": {
        "containerPort": {
          "$ref": "#/definitions/portNumber"
        },
        "hostPort": {
          "$ref": "#/definitions/portNumber"
        }
      },
      "additionalProperties": false
    },
    "resourceMap": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
