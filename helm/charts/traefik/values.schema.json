{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "namespace",
    "replicaCount",
    "ports",
    "ingressClass",
    "resources"
  ],
  "properties": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "nameOverride": {
      "type": "string"
    },
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "ports": {
      "type": "object",
      "required": [
        "web",
        "websecure",
        "api"
      ],
      "properties": {
        "web": {
          "$ref": "#/definitions/port"
        },
        "websecure": {
          "$ref": "#/definitions/port"
        },
        "api": {
          "type": "object",
          "required": [
            "containerPort"
          ],
          "properties": {
            "containerPort": {
              "$ref": "#/definitions/portNumber"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingressClass": {
      "type": "object",
      "required": [
        "name",
        "isDefaultClass"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "isDefaultClass": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "$ref": "#/definitions/resourceMap"
        },
        "limits": {
          "$ref": "#/definitions/resourceMap"
        }
      },
      "additionalProperties": false
    },
    "podAnnotations": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "definitions": {
    "portNumber": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "port": {
      "type": "object",
      "required": [
        "containerPort",
        "hostPort"
      ],
      "properties": {
        "containerPort": {
          "$ref": "#/definitions/portNumber"
        },
        "hostPort": {
          "$ref": "#/definitions/portNumber"
        }
      },
      "additionalProperties": false
    },
    "resourceMap": {
      "type": "object",
      "required": [
        "cpu",
        "memory"
      ],
      "properties": {
        "cpu": {
          "type": "string",
          "minLength": 1
        },
        "memory": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}