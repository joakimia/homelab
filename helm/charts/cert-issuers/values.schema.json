{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "clusterIssuer",
    "acme",
    "defaultSecrets",
    "name",
    "defaultEnv",
    "env",
    "secrets"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "clusterIssuer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "acme": {
      "type": "object",
      "required": [
        "enabled",
        "issuers"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "issuers": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      },
      "additionalProperties": false
    },
    "defaultSecrets": {
      "type": "object",
      "required": [
        "ca",
        "cloudflare"
      ],
      "properties": {
        "ca": {
          "type": "object",
          "required": [
            "name",
            "keys"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "keys": {
              "type": "object",
              "required": [
                "certificate",
                "privateKey"
              ],
              "properties": {
                "certificate": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                },
                "privateKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "cloudflare": {
          "type": "object",
          "required": [
            "name",
            "keys"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "keys": {
              "type": "object",
              "required": [
                "apiToken"
              ],
              "properties": {
                "apiToken": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "defaultEnv": {
      "type": "object",
      "maxProperties": 0,
      "description": "No pod in this chart; kept for the shared value layout."
    },
    "env": {
      "type": "object",
      "maxProperties": 0,
      "description": "No pod in this chart; kept for the shared value layout."
    },
    "secrets": {
      "type": "object",
      "properties": {
        "ca": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "keys": {
              "type": "object",
              "properties": {
                "certificate": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                },
                "privateKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "cloudflare": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "keys": {
              "type": "object",
              "properties": {
                "apiToken": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
