{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "clusterIssuer",
    "defaultSecrets"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "clusterIssuer": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "defaultSecrets": {
      "type": "object",
      "required": [
        "ca"
      ],
      "properties": {
        "ca": {
          "type": "object",
          "required": [
            "name",
            "keys"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "keys": {
              "type": "object",
              "required": [
                "certificate",
                "privateKey"
              ],
              "properties": {
                "certificate": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                },
                "privateKey": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
