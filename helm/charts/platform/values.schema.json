{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespaces",
    "networkPolicies",
    "storageClass"
  ],
  "properties": {
    "namespaces": {
      "type": "object",
      "required": [
        "networking",
        "frontend",
        "backendApi",
        "backgroundWorkers",
        "mqtt",
        "amqp",
        "database",
        "filestore",
        "storage",
        "platform",
        "tools",
        "observability",
        "observabilityAgents"
      ],
      "additionalProperties": false,
      "properties": {
        "networking": {
          "$ref": "#/definitions/namespace"
        },
        "frontend": {
          "$ref": "#/definitions/namespace"
        },
        "backendApi": {
          "$ref": "#/definitions/namespace"
        },
        "backgroundWorkers": {
          "$ref": "#/definitions/namespace"
        },
        "mqtt": {
          "$ref": "#/definitions/namespace"
        },
        "amqp": {
          "$ref": "#/definitions/namespace"
        },
        "database": {
          "$ref": "#/definitions/namespace"
        },
        "filestore": {
          "$ref": "#/definitions/namespace"
        },
        "storage": {
          "$ref": "#/definitions/namespace"
        },
        "platform": {
          "$ref": "#/definitions/namespace"
        },
        "tools": {
          "$ref": "#/definitions/namespace"
        },
        "observability": {
          "$ref": "#/definitions/namespace"
        },
        "observabilityAgents": {
          "$ref": "#/definitions/namespace"
        }
      }
    },
    "networkPolicies": {
      "type": "object",
      "required": [
        "enabled",
        "dns",
        "traefik",
        "pgadmin",
        "pgbouncer",
        "postgres",
        "postgresSetup",
        "grafana",
        "prometheus",
        "loki",
        "tempo",
        "alloy"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "dns": {
          "type": "object",
          "required": [
            "namespace",
            "podSelector"
          ],
          "properties": {
            "namespace": {
              "type": "string",
              "minLength": 1
            },
            "podSelector": {
              "$ref": "#/definitions/labelSelector"
            }
          },
          "additionalProperties": false
        },
        "traefik": {
          "type": "object",
          "required": [
            "podSelector",
            "ports",
            "internalPort"
          ],
          "properties": {
            "podSelector": {
              "$ref": "#/definitions/labelSelector"
            },
            "ports": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "integer"
                ],
                "pattern": "^[a-z0-9-]+$",
                "minimum": 1,
                "maximum": 65535
              }
            },
            "internalPort": {
              "type": [
                "string",
                "integer"
              ],
              "pattern": "^[a-z0-9-]+$",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        },
        "pgadmin": {
          "$ref": "#/definitions/workloadSelector"
        },
        "pgbouncer": {
          "$ref": "#/definitions/workloadSelector"
        },
        "postgres": {
          "$ref": "#/definitions/workloadSelector"
        },
        "postgresSetup": {
          "$ref": "#/definitions/workloadSelector"
        },
        "grafana": {
          "$ref": "#/definitions/workloadSelector"
        },
        "prometheus": {
          "$ref": "#/definitions/workloadSelector"
        },
        "loki": {
          "$ref": "#/definitions/workloadSelector"
        },
        "tempo": {
          "$ref": "#/definitions/workloadSelector"
        },
        "alloy": {
          "type": "object",
          "required": [
            "podSelector",
            "otlpPorts"
          ],
          "properties": {
            "podSelector": {
              "$ref": "#/definitions/labelSelector"
            },
            "otlpPorts": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "integer"
                ],
                "pattern": "^[a-z0-9-]+$",
                "minimum": 1,
                "maximum": 65535
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "storageClass": {
      "type": "object",
      "required": [
        "enabled",
        "name",
        "provisioner",
        "reclaimPolicy",
        "volumeBindingMode"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provisioner": {
          "type": "string",
          "minLength": 1
        },
        "reclaimPolicy": {
          "type": "string",
          "enum": [
            "Delete",
            "Retain",
            "Recycle"
          ]
        },
        "volumeBindingMode": {
          "type": "string",
          "enum": [
            "Immediate",
            "WaitForFirstConsumer"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "definitions": {
    "namespace": {
      "type": "object",
      "required": [
        "name",
        "purpose",
        "podSecurityEnforce",
        "enabled"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "podSecurityEnforce": {
          "type": "string",
          "enum": [
            "privileged",
            "baseline",
            "restricted"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "labelSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "workloadSelector": {
      "type": "object",
      "required": [
        "podSelector"
      ],
      "properties": {
        "podSelector": {
          "$ref": "#/definitions/labelSelector"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
