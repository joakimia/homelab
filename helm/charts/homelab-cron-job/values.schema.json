{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "namespace",
    "name",
    "image",
    "resources",
    "securityContext",
    "podSecurityContext",
    "schedule",
    "concurrencyPolicy",
    "startingDeadlineSeconds",
    "successfulJobsHistoryLimit",
    "failedJobsHistoryLimit",
    "backoffLimit",
    "activeDeadlineSeconds",
    "rbac",
    "defaultEnv",
    "env",
    "defaultSecrets",
    "secrets"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 52,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "schedule": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string"
    },
    "concurrencyPolicy": {
      "enum": [
        "Allow",
        "Forbid",
        "Replace"
      ]
    },
    "startingDeadlineSeconds": {
      "type": "integer",
      "minimum": 10
    },
    "successfulJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "failedJobsHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "backoffLimit": {
      "type": "integer",
      "minimum": 0
    },
    "activeDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "script": {
      "type": "string"
    },
    "scriptConfigMap": {
      "type": "string"
    },
    "rbac": {
      "type": "object",
      "required": [
        "clusterRules"
      ],
      "properties": {
        "clusterRules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "apiGroups",
              "resources",
              "verbs"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "defaultEnv": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "required": [
        "HOME"
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "defaultSecrets": {
      "type": "object",
      "required": [],
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "env": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "env"
            ]
          },
          {
            "required": [
              "mountPath"
            ]
          }
        ]
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    }
  }
}
