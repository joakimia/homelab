{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "name",
    "namespace",
    "host",
    "image",
    "replicaCount",
    "resources",
    "probes",
    "service",
    "defaultEnv",
    "env",
    "defaultSecrets",
    "secrets",
    "ingress",
    "storage",
    "config",
    "podSecurityContext",
    "securityContext"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "tls",
        "auth"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "clusterIssuer"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clusterIssuer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "required": [
            "enabled",
            "middleware"
          ],
          "properties": {
            "enabled": {
              "const": false
            },
            "middleware": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "required": [
        "readiness",
        "liveness",
        "startup"
      ],
      "properties": {
        "readiness": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        },
        "startup": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "port",
        "containerPort"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "defaultEnv": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "required": [
        "AUTHELIA_LOG_LEVEL",
        "AUTHELIA_SERVER_DISABLE_HEALTHCHECK",
        "AUTHELIA_IDENTITY_VALIDATION_RESET_PASSWORD_JWT_SECRET_FILE",
        "AUTHELIA_SESSION_SECRET_FILE",
        "AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE"
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "defaultSecrets": {
      "type": "object",
      "required": [
        "authelia"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "env": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "env"
            ]
          },
          {
            "required": [
              "mountPath"
            ]
          }
        ]
      },
      "properties": {
        "authelia": {
          "type": "object",
          "required": [
            "name",
            "mountPath",
            "keys"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "env": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[-._a-zA-Z0-9]+$"
              }
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[-._a-zA-Z0-9]+$"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "resources": {
      "type": "object"
    },
    "storage": {
      "type": "object",
      "required": [
        "size"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 1
        },
        "storageClassName": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": [
        "session",
        "accessControl"
      ],
      "properties": {
        "session": {
          "type": "object",
          "required": [
            "domain",
            "autheliaUrl",
            "defaultRedirectionUrl"
          ],
          "properties": {
            "domain": {
              "type": "string",
              "minLength": 1
            },
            "autheliaUrl": {
              "type": "string",
              "pattern": "^https://"
            },
            "defaultRedirectionUrl": {
              "type": "string",
              "pattern": "^https://"
            }
          },
          "additionalProperties": false
        },
        "accessControl": {
          "type": "object",
          "required": [
            "defaultPolicy"
          ],
          "properties": {
            "defaultPolicy": {
              "enum": [
                "deny",
                "bypass",
                "one_factor",
                "two_factor"
              ]
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
