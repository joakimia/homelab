      "type": "object",
      "required": [],
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "env"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
