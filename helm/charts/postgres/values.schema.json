{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "replicaCount",
    "probes",
    "service",
    "defaultEnv",
    "env",
    "defaultSecrets",
    "secrets",
    "podSecurityContext",
    "securityContext",
    "roles",
    "databases"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "required": [
        "readiness",
        "liveness",
        "startup"
      ],
      "properties": {
        "readiness": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        },
        "liveness": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        },
        "startup": {
          "type": "object",
          "required": [
            "initialDelaySeconds",
            "periodSeconds",
            "timeoutSeconds",
            "failureThreshold"
          ],
          "properties": {
            "exec": {
              "type": "object",
              "required": [
                "command"
              ],
              "properties": {
                "command": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "httpGet": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "scheme": {
                  "enum": [
                    "HTTP",
                    "HTTPS"
                  ]
                },
                "host": {
                  "type": "string"
                },
                "httpHeaders": {
                  "type": "array"
                }
              },
              "additionalProperties": false
            },
            "tcpSocket": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "host": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "grpc": {
              "type": "object",
              "required": [
                "port"
              ],
              "properties": {
                "port": {
                  "type": "integer"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "initialDelaySeconds": {
              "type": "integer",
              "minimum": 0
            },
            "periodSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "failureThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "successThreshold": {
              "type": "integer",
              "minimum": 1
            },
            "terminationGracePeriodSeconds": {
              "type": "integer",
              "minimum": 1
            }
          },
          "oneOf": [
            {
              "required": [
                "exec"
              ]
            },
            {
              "required": [
                "httpGet"
              ]
            },
            {
              "required": [
                "tcpSocket"
              ]
            },
            {
              "required": [
                "grpc"
              ]
            }
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "service": {
      "type": "object",
      "required": [
        "port",
        "containerPort"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "containerPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      },
      "additionalProperties": false
    },
    "defaultEnv": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "required": [
        "PGDATA"
      ]
    },
    "env": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "defaultSecrets": {
      "type": "object",
      "required": [
        "credentials"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "env": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "env"
            ]
          },
          {
            "required": [
              "mountPath"
            ]
          }
        ]
      },
      "properties": {
        "credentials": {
          "type": "object",
          "required": [
            "name",
            "env"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
            },
            "env": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[-._a-zA-Z0-9]+$"
              },
              "required": [
                "POSTGRES_DB",
                "POSTGRES_USER",
                "POSTGRES_PASSWORD"
              ]
            },
            "mountPath": {
              "type": "string",
              "pattern": "^/"
            },
            "keys": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[-._a-zA-Z0-9]+$"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          },
          "env": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          },
          "mountPath": {
            "type": "string",
            "pattern": "^/"
          },
          "keys": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "options",
          "passwordSecret"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,62}$"
          },
          "options": {
            "type": "array",
            "items": {
              "enum": [
                "LOGIN",
                "NOLOGIN",
                "CREATEDB",
                "NOCREATEDB",
                "CREATEROLE",
                "NOCREATEROLE",
                "INHERIT",
                "NOINHERIT",
                "REPLICATION",
                "NOREPLICATION",
                "BYPASSRLS",
                "NOBYPASSRLS"
              ]
            }
          },
          "passwordSecret": {
            "type": "object",
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "key": {
                "type": "string",
                "pattern": "^[-._a-zA-Z0-9]+$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "databases": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z_][a-z0-9_-]{0,62}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner"
        ],
        "properties": {
          "owner": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,62}$"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
