{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "host",
    "ingress",
    "authentik"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "tls"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "clusterIssuer"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clusterIssuer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "authentik": {
      "type": "object",
      "required": [
        "fullnameOverride",
        "global",
        "authentik",
        "postgresql"
      ],
      "properties": {
        "fullnameOverride": {
          "type": "string",
          "minLength": 1
        },
        "global": {
          "type": "object",
          "required": [
            "env"
          ],
          "properties": {
            "env": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "authentik": {
          "type": "object",
          "required": [
            "postgresql"
          ],
          "properties": {
            "secret_key": {
              "description": "Comes from the authentik-credentials Secret, never from values.",
              "const": ""
            },
            "postgresql": {
              "type": "object",
              "required": [
                "host",
                "name",
                "user"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "user": {
                  "type": "string",
                  "minLength": 1
                },
                "password": {
                  "description": "Comes from the authentik-postgres Secret, never from values.",
                  "const": ""
                }
              }
            }
          }
        },
        "postgresql": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "description": "The in-cluster postgres chart is used instead of the bundled one.",
              "const": false
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
