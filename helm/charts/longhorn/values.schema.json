{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "host",
    "ingress",
    "longhorn"
  ],
  "properties": {
    "host": {
      "type": "string",
      "minLength": 1
    },
    "ingress": {
      "type": "object",
      "required": [
        "className",
        "tls",
        "auth",
        "backend"
      ],
      "properties": {
        "className": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "required": [
            "enabled",
            "clusterIssuer"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "clusterIssuer": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "auth": {
          "type": "object",
          "required": [
            "enabled",
            "middleware"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "middleware": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "required": [
            "service",
            "port"
          ],
          "properties": {
            "service": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "longhorn": {
      "type": "object",
      "required": [
        "persistence",
        "ingress"
      ],
      "properties": {
        "persistence": {
          "type": "object",
          "properties": {
            "defaultClass": {
              "type": "boolean"
            },
            "defaultClassReplicaCount": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "ingress": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "const": false,
              "description": "The top-level ingress publishes the UI; the upstream one stays off."
            }
          }
        }
      }
    },
    "global": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
